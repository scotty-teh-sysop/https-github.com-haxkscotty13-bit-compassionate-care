rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Seniors collection: accessible to authenticated users
    match /seniors/{seniorId} {
      allow read, write: if true;
    }

    // Companions collection: accessible to authenticated users
    match /companions/{companionId} {
      allow read, write: if true;
    }

    // Bookings collection: tracks scheduled, live, and completed visits with summaries
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Notifications collection: alerts and updates
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // FCM Device Tokens for 1-hour pre-visit notifications
    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
